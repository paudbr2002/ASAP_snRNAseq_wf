FROM mambaorg/micromamba:latest

USER root

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        gcc g++ make libhdf5-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Core data/science stack ───────────────────────────────────────────────────
RUN micromamba install -y -c conda-forge -c bioconda \
        python=3.11 \
        pandas \
        numpy \
        scipy \
        matplotlib \
        seaborn \
        scikit-image \
        scikit-learn \
        numba \
        h5py \
        pytables \
        tqdm \
        joblib

# ── scanpy ecosystem ─────────────────────────────────────────────────────────
RUN micromamba install -y -c conda-forge -c bioconda \
        scanpy \
        anndata \
        leidenalg \
        python-igraph \
        umap-learn \
        pynndescent \
        louvain

# ── Additional utilities ──────────────────────────────────────────────────────
RUN micromamba install -y -c conda-forge \
        openpyxl

# ── pip-only packages ────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
        harmonypy \
        scrublet \
        session-info

# ── Clean up ──────────────────────────────────────────────────────────────────
RUN micromamba clean --all -f -y && pip cache purge

# ── Environment ───────────────────────────────────────────────────────────────
ENV PATH="/opt/conda/bin:$PATH" \
    MPLBACKEND="Agg" \
    HDF5_USE_FILE_LOCKING="FALSE" \
    NUMBA_CACHE_DIR="/tmp/numba_cache" \
    MPLCONFIGDIR="/tmp/matplotlib"

ENTRYPOINT ["python"]
